{
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "name": "frontend",
  "projectType": "application",
  "generators": {
    "@schematics/angular:component": {
      "style": "scss"
    }
  },
  "sourceRoot": "apps/frontend/src",
  "prefix": "app",
  "targets": {
    "build": {
      "executor": "@angular-devkit/build-angular:application",
      "options": {
        "outputPath": "dist/frontend",
        "index": "apps/frontend/src/index.html",
        "polyfills": ["apps/frontend/src/polyfills.ts"],
        "tsConfig": "apps/frontend/tsconfig.app.json",
        "inlineStyleLanguage": "scss",
        "assets": [
          "apps/frontend/src/favicon.ico",
          "apps/frontend/src/assets",
          "apps/frontend/src/manifest.webmanifest",
          "apps/frontend/src/robots.txt",
          "apps/frontend/src/sitemap.xml"
        ],
        "styles": [
          "apps/frontend/src/styles.scss",
          "apps/frontend/src/assets/themes/theme.scss"
        ],
        "stylePreprocessorOptions": {
          "includePaths": ["apps/frontend/src/assets/themes"]
        },
        "scripts": [],
        "serviceWorker": "ngsw-config.json",
        "browser": "apps/frontend/src/main.ts",
        "server": "apps/frontend/src/main.server.ts",
        "prerender": true,
        "ssr": {
          "entry": "server.ts"
        }
      },
      "configurations": {
        "production": {
          "budgets": [
            {
              "type": "initial",
              "maximumWarning": "500kb",
              "maximumError": "1mb"
            },
            {
              "type": "anyComponentStyle",
              "maximumWarning": "4kb",
              "maximumError": "6kb"
            }
          ],
          "fileReplacements": [
            {
              "replace": "apps/frontend/src/environments/environment.ts",
              "with": "apps/frontend/src/environments/environment.prod.ts"
            }
          ],
          "outputHashing": "all"
        },
        "development": {
          "optimization": false,
          "extractLicenses": false,
          "sourceMap": true,
          "namedChunks": true
        }
      },
      "defaultConfiguration": "production"
    },
    "serve": {
      "executor": "@angular-devkit/build-angular:dev-server",
      "configurations": {
        "production": {
          "buildTarget": "frontend:build:production"
        },
        "development": {
          "buildTarget": "frontend:build:development"
        }
      },
      "defaultConfiguration": "development"
    },
    "extract-i18n": {
      "executor": "@angular-devkit/build-angular:extract-i18n",
      "options": {
        "buildTarget": "frontend:build"
      }
    },
    "test": {
      "executor": "@angular-devkit/build-angular:karma",
      "options": {
        "main": "apps/frontend/src/test.ts",
        "polyfills": "apps/frontend/src/polyfills.ts",
        "tsConfig": "apps/frontend/tsconfig.spec.json",
        "karmaConfig": "apps/frontend/karma.conf.js",
        "inlineStyleLanguage": "scss",
        "assets": [
          "apps/frontend/src/favicon.ico",
          "apps/frontend/src/assets",
          "apps/frontend/src/manifest.webmanifest"
        ],
        "styles": [
          "apps/frontend/src/styles.scss",
          "apps/frontend/src/assets/themes/theme.scss"
        ],
        "stylePreprocessorOptions": {
          "includePaths": ["apps/frontend/src/assets/themes"]
        },
        "scripts": []
      }
    },
    "lint": {
      "executor": "@angular-eslint/builder:lint",
      "options": {
        "lintFilePatterns": [
          "apps/frontend/src/**/*.ts",
          "apps/frontend/src/**/*.html"
        ]
      },
      "outputs": ["{options.outputFile}"]
    }
  }
}
